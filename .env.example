# Public client configuration ONLY. No database credentials or JWT secrets.
# Leave unset for existing LAN / Android emulator / localhost detection (port 5000).
# EXPO_PUBLIC_API_URL=http://localhost:5000
# Physical device: http://<development-machine-LAN-IP>:5000
# Production/beta: uncomment in .env.local, then restart Expo.
# EXPO_PUBLIC_API_URL=

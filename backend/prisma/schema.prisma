generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  username     String            @unique
  passwordHash String
  avatarUrl    String?
  role         String            @default("user")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  profile      Profile?
  library      LibraryEntry[]
  readingProg  ReadingProgress[]
  watchProg    WatchProgress[]
  history      HistoryEntry[]
  providers    ProviderConfig[]
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  bio               String?
  preferredLanguage String   @default("en")
  preferredTheme    String   @default("dark")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LibraryEntry {
  id             String   @id @default(uuid())
  userId         String
  mediaId        String
  providerId     String
  sourceId       String
  mediaType      String
  title          String
  coverUrl       String
  status         String   @default("reading")
  isFavorite     Boolean  @default(false)
  currentChapter String?
  currentEpisode String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
}

model ReadingProgress {
  id            String   @id @default(uuid())
  userId        String
  mediaId       String
  chapterId     String
  chapterNumber Float
  chapterTitle  String
  pageNumber    Int      @default(1)
  totalPages    Int      @default(1)
  progress      Float    @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, chapterId])
  @@index([userId, mediaId])
}

model WatchProgress {
  id              String   @id @default(uuid())
  userId          String
  mediaId         String
  episodeId       String
  episodeNumber   Int
  episodeTitle    String
  positionSeconds Float    @default(0)
  durationSeconds Float    @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, episodeId])
  @@index([userId, mediaId])
}

model HistoryEntry {
  id         String   @id @default(uuid())
  userId     String
  mediaId    String
  providerId String
  sourceId   String
  mediaType  String
  title      String
  coverUrl   String
  itemId     String
  itemTitle  String
  itemType   String
  progress   Float    @default(0)
  viewedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
}

model ProviderConfig {
  id            String   @id @default(uuid())
  userId        String
  providerId    String
  customUrl     String?
  isEnabled     Boolean  @default(true)
  customHeaders String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
}

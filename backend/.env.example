HOST="0.0.0.0"
PORT=5000
NODE_ENV=development

# Local foundation uses SQLite for zero-setup development.
DATABASE_URL="file:./dev.db"

# Production / shared MySQL example. Use this as DATABASE_URL only in the
# production environment after creating and reviewing a MySQL Prisma migration.
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Use a long random secret in real deployments.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated origins, or * for local development.
# Comma-separated trusted web origins. Mobile clients normally send no Origin.
CORS_ORIGIN="http://localhost:8081"

# Optional upstream novel content service for /api/novels and /api/content novel routes.
# Expected contract (JSON):
#   GET /search?q=
#   GET /:novelId
#   GET /:novelId/chapters
#   GET /:novelId/chapters/:chapterId
# NOVEL_GATEWAY_URL="http://127.0.0.1:8000"

# Optional self-hosted Consumet base URL (public api.consumet.org returns HTTP 451).
# CONSUMET_BASE_URL="http://127.0.0.1:3000"

# Optional future scraper backend.
# SCRAPER_BACKEND_URL="http://127.0.0.1:7000"

# Outbound provider request timeout in milliseconds.
PROVIDER_REQUEST_TIMEOUT_MS=15000

# Asura Scans scraper configuration
ASURA_BASE_URL="https://asurascans.com"
ASURA_TIMEOUT="10000"
ASURA_RATE_LIMIT_MS="1000"
